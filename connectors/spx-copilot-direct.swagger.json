    "/copilotstudio/dataverse-backed/authenticated/bots/{agent}/conversations": {
      "post": {
        "summary": "Start a conversation with an agent",
        "operationId": "StartConversation",
        "parameters": [
          {
            "name": "agent",
            "type": "string",
            "required": true,
            "description": "Agent schema name, e.g. cr56c_spocode",
            "in": "path"
          },
          {
            "name": "api-version",
            "type": "string",
            "required": false,
            "description": "Direct-to-Engine API version",
            "in": "query",
            "default": "2022-03-01-preview",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "emitStartConversationEvent": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/copilotstudio/dataverse-backed/authenticated/bots/{agent}/conversations/{conversationId}": {
      "post": {
        "summary": "Send a message to an agent (execute turn)",
        "operationId": "SendMessage",
        "parameters": [
          {
            "name": "agent",
            "type": "string",
            "required": true,
            "description": "Agent schema name",
            "in": "path"
          },
          {
            "name": "conversationId",
            "type": "string",
            "required": true,
            "description": "Id returned by StartConversation",
            "in": "path"
          },
          {
            "name": "api-version",
            "type": "string",
            "required": false,
            "description": "Direct-to-Engine API version",
            "in": "query",
            "default": "2022-03-01-preview",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "activity": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "default": "message"
                    },
                    "text": {
                      "type": "string",
                      "description": "User message"
                    },
                    "conversation": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                }
              },
              "required": [
                "activity"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "Error"
          }
        }
      }
    },
    "/mcp": {
