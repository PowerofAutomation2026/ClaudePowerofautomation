{
  "inputs": [
    { "id": "tenantId", "type": "promptString", "description": "Entra tenant ID" },
    { "id": "clientId", "type": "promptString", "description": "Entra app (client) ID: public client, delegated Power Platform API CopilotStudio.Copilots.Invoke" },
    { "id": "envId", "type": "promptString", "description": "Power Platform environment ID (GUID from the Copilot Studio URL after /environments/)" },
    { "id": "agents", "type": "promptString", "description": "Agent schema name, or alias=schema,alias2=schema2 for several (schema is case-sensitive)" },
    { "id": "harness", "type": "pickString", "description": "Agent harness", "options": ["auto", "github", "standard"], "default": "auto" }
  ],
  "servers": {
    "copilot-studio-agent": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/mcp/copilot-studio-mcp.mjs"],
      "env": {
        "TENANT_ID": "${input:tenantId}",
        "CLIENT_ID": "${input:clientId}",
        "ENV_ID": "${input:envId}",
        "AGENTS": "${input:agents}",
        "HARNESS": "${input:harness}",
        "SHOW_REASONING": "false",
        "SHOW_TOOLCALLS": "false",
        "TOKEN_CACHE": "memory"
      }
    }
  }
}
