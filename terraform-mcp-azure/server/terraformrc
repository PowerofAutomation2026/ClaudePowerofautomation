# Providers come ONLY from the copies baked into the image (see Dockerfile). Terraform never
# contacts the public registry at run time, so a template cannot pull an unreviewed provider.
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform/providers"
    include = ["registry.terraform.io/hashicorp/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
disable_checkpoint = true
